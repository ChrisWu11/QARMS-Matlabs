    -I"D:\R2024b\extern\include" \
    -I"D:\R2024b\simulink\include" \
    -I"D:\R2024b\rtw\c\src" 

THIRD_PARTY_INCLUDES = -I"C:\Users\tedzh\AppData\Roaming\MathWorks\MATLAB Add-Ons\Simulink Models\Quanser QArm Pick and Place using MathWorks Toolboxes\slprj\_cgxe\PickAndPlace_Simulation_QLabs\src" -I"D:\R2024b\extern\include\shared_robotics" -I"D:\R2024b\toolbox\shared\robotics\externalDependency\libccd\src" -I"D:\R2024b\toolbox\shared\robotics\externalDependency\libccd\src\ccd" 

