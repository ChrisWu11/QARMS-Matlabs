#----------------- Compiler and Linker Options --------------------------------
 
# Optimization Options
 
CC_OPTS =  -w   -Dccd_EXPORTS
CPP_REQ_DEFINES = -DMATLAB_MEX_FILE
 
# Uncomment this line to move warning level to W4
# cflags = $(cflags:W3=W4)
CFLAGS = $(CPP_REQ_DEFINES) $(INCLUDE_PATH) CFLAGS="$$CFLAGS $(CC_OPTS)"
 
LDFLAGS =  
 
AUXLDFLAGS = 
#----------------------------- Source Files -----------------------------------
 
THIRD_PARTY_SRCS = D:/R2024b/toolbox/shared/robotics/externalDependency/libccd/src/ccd_ccd.c D:/R2024b/toolbox/shared/robotics/externalDependency/libccd/src/ccd_mpr.c D:/R2024b/toolbox/shared/robotics/externalDependency/libccd/src/ccd_polytope.c D:/R2024b/toolbox/shared/robotics/externalDependency/libccd/src/ccd_vec3.c D:/R2024b/toolbox/shared/robotics/robotcore/builtins/libsrc/collisioncodegen/collisioncodegen_CollisionGeometry.cpp D:/R2024b/toolbox/shared/robotics/robotcore/builtins/libsrc/collisioncodegen/collisioncodegen_api.cpp D:/R2024b/toolbox/shared/robotics/robotcore/builtins/libsrc/collisioncodegen/collisioncodegen_ccdExtensions.cpp D:/R2024b/toolbox/shared/robotics/robotcore/builtins/libsrc/collisioncodegen/collisioncodegen_checkCollision.cpp  
